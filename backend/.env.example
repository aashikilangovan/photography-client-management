APP_NAME="Photography API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite needs nothing running — it's a single file at database/database.sqlite.
# This is the default for running the app directly with `php artisan serve`.
DB_CONNECTION=sqlite

# --- Postgres (only used by `docker compose up` — see docker-compose.yml,
# which sets these same variables explicitly and ignores the block above) ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=photography
# DB_USERNAME=photography
# DB_PASSWORD=photography

CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
